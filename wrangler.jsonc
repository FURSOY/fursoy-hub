{
  "name": "fursoy-hub",
  "compatibility_date": "2026-09-19",
  "main": "worker.js",
  "routes": [
    { "pattern": "fursoy.com", "custom_domain": true },
    { "pattern": "www.fursoy.com", "custom_domain": true }
  ],
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
